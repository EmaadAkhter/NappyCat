<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug builds only: the Firebase emulators speak plain HTTP/gRPC, and
         Android blocks cleartext by default from API 28. Never merged into
         release. -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />
</manifest>
