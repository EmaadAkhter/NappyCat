<?xml version="1.0" encoding="utf-8"?>
<!-- Comic layout: speech bubble on top, tail pointing down, the cat big
     underneath. Colours are CozyColors tokens verbatim — RemoteViews cannot
     read a theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/tidal_widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bubble"
        android:padding="10dp">

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="#4A3525"
            android:textSize="13sp"
            android:text="Nothing yet" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#998475"
            android:textSize="10sp"
            android:text="" />
    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="12dp"
        android:layout_marginStart="34dp"
        android:layout_marginTop="-1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/bubble_tail_down" />

    <!-- Takes all remaining height: the cat is the star. -->
    <ImageView
        android:id="@+id/cat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/tidal_widget_description"
        android:src="@drawable/tabby_asleep" />
</LinearLayout>
