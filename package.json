{
  "name": "tidal-rules",
  "private": true,
  "type": "module",
  "description": "Firestore security rules + emulator tests for Tidal",
  "scripts": {
    "devrules": "node tools/make_dev_rules.mjs",
    "test": "mocha test/rules.test.mjs --timeout 20000",
    "test:emulator": "firebase emulators:exec --project demo-tidal \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.2.0",
    "mocha": "^11.0.1"
  }
}
